# TZKV OP-TEE block-table defense for vLLM.
#
# First-stage defense:
#   REE/vLLM builds block-table tensors, but OP-TEE records the committed
#   effective block-table root and verifies the effective root immediately before
#   attention consumes it.
#
# This file intentionally uses tee-llm-thor's current Python client:
#   /home/xx/tee-llm-thor/python/tzkv_optee_client.py
#
# Full semantic BT mode is left disabled until KV commit is integrated.

from __future__ import annotations

import hashlib
import json
import os
import socket
import sys
import threading
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any, List, Optional, Sequence, Tuple

try:
    import numpy as np
except Exception:  # pragma: no cover
    np = None


TZKV_FLAG_NONE = 0x00000000
TZKV_FLAG_STRICT = 0x00000001
TZKV_HASH_ZERO = "00" * 32


def _env_bool(name: str, default: str = "0") -> bool:
    return os.getenv(name, default).strip().lower() in ("1", "true", "yes", "on")


def _u64_from_text(text: str) -> int:
    h = hashlib.blake2b(text.encode("utf-8", "replace"), digest_size=8).digest()
    return int.from_bytes(h, "little", signed=False)


def _stable_session_id() -> int:
    explicit = os.getenv("TZKV_OPTEE_BT_SESSION_ID")
    if explicit:
        return int(explicit, 0)
    seed = f"{socket.gethostname()}:{os.getpid()}:{time.time_ns()}"
    return _u64_from_text(seed)


@dataclass
class TzkvBtGuardConfig:
    enabled: bool
    strict: bool
    tee_repo: str
    tool: str
    lib: str
    log_path: str
    session_id: int
    block_size: int
    max_entries: int
    reset_on_init: bool
    commit_mode: str
    tamper_after_commit: bool
    tamper_once: bool
    local_fallback: bool

    @staticmethod
    def from_env() -> "TzkvBtGuardConfig":
        tee_repo = os.getenv("TZKV_OPTEE_BT_REPO", "/home/xx/tee-llm-thor")
        return TzkvBtGuardConfig(
            enabled=_env_bool("TZKV_OPTEE_BT_ENABLE", "0"),
            strict=_env_bool("TZKV_OPTEE_BT_STRICT", "1"),
            tee_repo=tee_repo,
            tool=os.getenv(
                "TZKV_OPTEE_BT_TOOL",
                str(Path(tee_repo) / "ca" / "tzkv_tool"),
            ),
            lib=os.getenv(
                "TZKV_OPTEE_BT_LIB",
                str(Path(tee_repo) / "ca" / "libtzkv_client.so"),
            ),
            log_path=os.getenv(
                "TZKV_OPTEE_BT_LOG",
                str(Path(tee_repo) / "logs" / "vllm_bt_defense.jsonl"),
            ),
            session_id=_stable_session_id(),
            block_size=int(os.getenv("TZKV_OPTEE_BT_BLOCK_SIZE", "16")),
            max_entries=int(os.getenv("TZKV_OPTEE_BT_MAX_ENTRIES", "256")),
            reset_on_init=_env_bool("TZKV_OPTEE_BT_RESET_ON_INIT", "0"),
            commit_mode=os.getenv("TZKV_OPTEE_BT_COMMIT_MODE", "root").strip().lower(),
            tamper_after_commit=_env_bool("TZKV_OPTEE_BT_TAMPER_AFTER_COMMIT", "0"),
            tamper_once=_env_bool("TZKV_OPTEE_BT_TAMPER_ONCE", "1"),
            local_fallback=_env_bool("TZKV_OPTEE_BT_LOCAL_FALLBACK", "0"),
        )


class TzkvOpteeBtGuard:
    def __init__(self, cfg: Optional[TzkvBtGuardConfig] = None) -> None:
        self.cfg = cfg or TzkvBtGuardConfig.from_env()
        self._lock = threading.Lock()
        self._initialized = False
        self._session_opened = False
        self._epoch = 0
        self._root_hex: Optional[str] = None
        self._last_shape: Optional[Tuple[int, ...]] = None
        self._last_req_ids: List[int] = []
        self._tamper_done = False
        self._client = None

        if self.cfg.enabled:
            Path(self.cfg.log_path).parent.mkdir(parents=True, exist_ok=True)
            self._log("guard_config", {
                "strict": self.cfg.strict,
                "tee_repo": self.cfg.tee_repo,
                "tool": self.cfg.tool,
                "lib": self.cfg.lib,
                "session_id": self.cfg.session_id,
                "block_size": self.cfg.block_size,
                "max_entries": self.cfg.max_entries,
                "reset_on_init": self.cfg.reset_on_init,
                "commit_mode": self.cfg.commit_mode,
                "tamper_after_commit": self.cfg.tamper_after_commit,
                "tamper_once": self.cfg.tamper_once,
                "local_fallback": self.cfg.local_fallback,
            })

            if self.cfg.commit_mode != "root":
                self._fail(
                    "Only TZKV_OPTEE_BT_COMMIT_MODE=root is supported in this "
                    "first-stage vLLM guard. Enable semantic mode after KV commit "
                    "is integrated."
                )

            py_dir = str(Path(self.cfg.tee_repo) / "python")
            if py_dir not in sys.path:
                sys.path.insert(0, py_dir)

            if not Path(self.cfg.lib).exists() and not Path(self.cfg.tool).exists():
                self._fail(
                    f"Neither TZKV client lib nor tool exists: lib={self.cfg.lib}, "
                    f"tool={self.cfg.tool}"
                )

            self._client = self._make_client()

            if self.cfg.reset_on_init:
                self._run_reset()

    def enabled(self) -> bool:
        return self.cfg.enabled

    def commit_and_verify(
        self,
        *,
        runner: Any,
        block_table: Any,
        phase: str,
        layer_id: int = 0,
    ) -> bool:
        if not self.cfg.enabled:
            return True

        with self._lock:
            bt_np = self._to_numpy_int64(block_table)
            shape = tuple(int(x) for x in bt_np.shape)
            req_ids = self._extract_request_ids(
                runner, expected_rows=shape[0] if shape else 0
            )
            root_hex = self._compute_bt_root(bt_np, req_ids=req_ids, layer_id=layer_id)
            num_entries, num_blocks = self._count_entries(bt_np)

            request_id = int(req_ids[0]) if req_ids else 0

            if not self._initialized:
                self._open_session(initial_bt_root=root_hex)

                self._initialized = True
                self._epoch = 0
                self._root_hex = root_hex
                self._last_shape = shape
                self._last_req_ids = list(req_ids)
                self._log("bt_session_open_ok", {
                    "phase": phase,
                    "epoch": self._epoch,
                    "root": root_hex,
                    "shape": shape,
                    "num_entries": num_entries,
                    "num_blocks": num_blocks,
                    "request_ids": list(req_ids),
                })

            elif root_hex != self._root_hex:
                old_epoch = self._epoch
                new_epoch = old_epoch + 1
                old_root = self._root_hex or TZKV_HASH_ZERO

                # First-stage root mode: update the committed BT root.
                # This uses tee-llm-thor's bt-init command as a root-mode commit
                # until full semantic bt-commit is enabled with KV commit.
                self._call_bt_init(epoch=new_epoch, root_hex=root_hex)

                self._epoch = new_epoch
                self._root_hex = root_hex
                self._last_shape = shape
                self._last_req_ids = list(req_ids)
                self._log("bt_root_commit_ok", {
                    "phase": phase,
                    "old_epoch": old_epoch,
                    "new_epoch": new_epoch,
                    "old_root": old_root,
                    "new_root": root_hex,
                    "shape": shape,
                    "num_entries": num_entries,
                    "num_blocks": num_blocks,
                    "request_ids": list(req_ids),
                    "commit_mode": self.cfg.commit_mode,
                })

            # Effective verification is always performed immediately before use.
            effective_root_hex = root_hex
            if self.cfg.tamper_after_commit and (
                not self.cfg.tamper_once or not self._tamper_done
            ):
                effective_root_hex = self._tamper_root_hex_for_defense_test(root_hex)
                self._tamper_done = True
                self._log("bt_defense_tamper_injected", {
                    "phase": phase,
                    "epoch": self._epoch,
                    "committed_root": root_hex,
                    "effective_root": effective_root_hex,
                    "shape": shape,
                    "num_entries": num_entries,
                    "num_blocks": num_blocks,
                    "request_ids": list(req_ids),
                })

            self._call_effective(
                epoch=self._epoch,
                root_hex=effective_root_hex,
                request_id=request_id,
                layer_id=layer_id,
            )
            self._log("bt_effective_ok", {
                "phase": phase,
                "epoch": self._epoch,
                "root": effective_root_hex,
                "committed_root": root_hex,
                "shape": shape,
                "num_entries": num_entries,
                "num_blocks": num_blocks,
                "request_ids": list(req_ids),
            })
            return True

    def _make_client(self):
        try:
            from tzkv_optee_client import TZKVClient
            return TZKVClient(
                tool=self.cfg.tool,
                lib=self.cfg.lib,
                local_fallback=self.cfg.local_fallback,
            )
        except Exception as exc:
            self._fail(f"failed to create TZKVClient: {exc}")

    def _open_session(self, *, initial_bt_root: str) -> None:
        zero = TZKV_HASH_ZERO
        nonce = hashlib.blake2b(
            f"{self.cfg.session_id}:{time.time_ns()}".encode(),
            digest_size=16,
        ).hexdigest()
        req = {
            "session_id": self.cfg.session_id,
            "flags": TZKV_FLAG_STRICT if self.cfg.strict else TZKV_FLAG_NONE,
            "initial_kv_epoch": 0,
            "initial_bt_epoch": 0,
            "initial_desc_epoch": 0,
            "app_hash": zero,
            "model_hash": zero,
            "tokenizer_hash": zero,
            "prompt_hash": zero,
            "initial_kv_root": zero,
            "initial_bt_root": initial_bt_root,
            "nonce": nonce,
        }
        resp = self._client.open_session(req)
        self._check_resp("open-session", resp, {"req": req})
        self._session_opened = True

    def _call_bt_init(self, *, epoch: int, root_hex: str) -> None:
        req = {
            "session_id": self.cfg.session_id,
            "flags": TZKV_FLAG_STRICT if self.cfg.strict else TZKV_FLAG_NONE,
            "bt_epoch": int(epoch),
            "bt_root": root_hex,
        }
        resp = self._client.bt_init(req)
        self._check_resp("bt-init", resp, {"req": req})

    def _call_effective(
        self,
        *,
        epoch: int,
        root_hex: str,
        request_id: int,
        layer_id: int,
    ) -> None:
        req = {
            "session_id": self.cfg.session_id,
            "request_id": int(request_id),
            "sequence_id": 0,
            "layer_id": int(layer_id),
            "bt_epoch": int(epoch),
            "effective_bt_root": root_hex,
        }
        resp = self._client.bt_verify_effective(req)
        self._check_resp("bt-effective", resp, {"req": req})

    def _run_reset(self) -> None:
        try:
            resp = self._client.reset()
            self._log("reset_on_init", {"resp": resp})
            # reset may be debug-gated in production TA; do not make first-stage
            # integration depend on it. Session ids are randomized per process.
        except Exception as exc:
            self._log("reset_on_init_error", {"message": str(exc)})

    def _check_resp(self, command: str, resp: dict, extra: dict | None = None) -> None:
        status_ok = int(resp.get("status", -1)) == 0
        if not status_ok:
            obj = {"command": command, "resp": resp}
            if extra:
                obj.update(extra)
            self._log("bt_guard_call_fail", obj)
            self._fail(f"TZKV {command} failed: {resp}")
        self._log("bt_guard_call_ok", {"command": command, "resp": resp})

    def _to_numpy_int64(self, tensor: Any):
        if np is None:
            self._fail("numpy is required by TZKV BT guard")

        obj = tensor
        try:
            if hasattr(obj, "detach"):
                obj = obj.detach()
            if hasattr(obj, "cpu"):
                obj = obj.cpu()
            if hasattr(obj, "contiguous"):
                obj = obj.contiguous()
            if hasattr(obj, "numpy"):
                obj = obj.numpy()
        except Exception as exc:
            self._fail(f"failed to move block_table tensor to CPU numpy: {exc}")

        arr = np.asarray(obj)
        if arr.ndim == 1:
            arr = arr.reshape(1, -1)
        return arr.astype(np.int64, copy=False)

    def _extract_request_ids(self, runner: Any, expected_rows: int) -> List[int]:
        candidates: List[Any] = []

        for obj in (
            getattr(runner, "input_batch", None),
            getattr(runner, "scheduler_output", None),
            runner,
        ):
            if obj is None:
                continue
            for name in ("req_ids", "request_ids", "requests", "request_id"):
                if hasattr(obj, name):
                    candidates.append(getattr(obj, name))

        for cand in candidates:
            try:
                if isinstance(cand, dict):
                    vals = list(cand.keys())
                elif isinstance(cand, (list, tuple)):
                    vals = list(cand)
                else:
                    vals = list(cand)
                if vals:
                    ids = [_u64_from_text(str(v)) for v in vals[:expected_rows]]
                    while len(ids) < expected_rows:
                        ids.append(len(ids) + 1)
                    return ids
            except Exception:
                continue

        return [i + 1 for i in range(expected_rows)]

    def _compute_bt_root(self, bt_np: Any, *, req_ids: Sequence[int], layer_id: int) -> str:
        h = hashlib.sha256()
        h.update(b"TZKV.vLLM.block_table.v1\0")
        h.update(int(layer_id).to_bytes(8, "little", signed=False))
        h.update(len(bt_np.shape).to_bytes(8, "little", signed=False))
        for dim in bt_np.shape:
            h.update(int(dim).to_bytes(8, "little", signed=False))
        h.update(len(req_ids).to_bytes(8, "little", signed=False))
        for rid in req_ids:
            h.update(int(rid).to_bytes(8, "little", signed=False))
        h.update(bt_np.tobytes(order="C"))
        return h.hexdigest()

    def _count_entries(self, bt_np: Any) -> tuple[int, int]:
        if bt_np.ndim == 1:
            vals = bt_np
        else:
            vals = bt_np.reshape(-1)
        n = 0
        for x in vals:
            try:
                if int(x) >= 0:
                    n += 1
            except Exception:
                pass
            if n >= self.cfg.max_entries:
                break
        return n, n

    def _tamper_root_hex_for_defense_test(self, root_hex: str) -> str:
        b = bytearray.fromhex(root_hex)
        if not b:
            return root_hex
        b[0] ^= 0x01
        return b.hex()

    def _log(self, event: str, obj: dict) -> None:
        if not self.cfg.enabled:
            return
        rec = {
            "ts": time.time(),
            "event": event,
            **obj,
        }
        try:
            with open(self.cfg.log_path, "a", encoding="utf-8") as f:
                f.write(json.dumps(rec, sort_keys=True) + "\n")
        except Exception:
            pass

    def _fail(self, msg: str) -> None:
        self._log("bt_guard_error", {"message": msg})
        if self.cfg.strict:
            raise RuntimeError(msg)
        return None


_GUARD: Optional[TzkvOpteeBtGuard] = None
_GUARD_LOCK = threading.Lock()


def get_tzkv_optee_bt_guard() -> TzkvOpteeBtGuard:
    global _GUARD
    with _GUARD_LOCK:
        if _GUARD is None:
            _GUARD = TzkvOpteeBtGuard()
        return _GUARD
